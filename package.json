{
  "name": "dsh-net-consent",
  "version": "1.0.0",
  "description": "DSH 联网审批插件：会话里自己抓网页、在命令行跑联网工具之前，先弹卡片确认。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "security",
    "network",
    "approval",
    "consent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsushjk/dsh-net-consent.git"
  },
  "homepage": "https://github.com/hsushjk/dsh-net-consent#readme",
  "bugs": {
    "url": "https://github.com/hsushjk/dsh-net-consent/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
